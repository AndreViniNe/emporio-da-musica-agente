# Qualquer provedor com API compatível com OpenAI (chat completions + tool calling).
# Copie para .env e preencha. Descomente UM dos blocos abaixo.

# --- Hugging Face Inference Providers (padrão) ---
# Token: https://huggingface.co/settings/tokens (permissão "Make calls to Inference Providers")
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_xxx
LLM_MODEL=openai/gpt-oss-120b

# --- Groq (mesmos modelos abertos, plano gratuito) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxx
# LLM_MODEL=openai/gpt-oss-120b

# --- Ollama local (sem chave; modelos menores são menos confiáveis em tool calling) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2

# Opcional: fixa a "data de hoje" do agente (AAAA-MM-DD). Útil para reproduzir
# cenários, já que os pedidos da base vão de out/2025 a mar/2026.
# DATA_REFERENCIA=2026-03-25
